# ----------------- DATABASE SETUP -----------------
conn = sqlite3.connect('ugc_marketplace.db', check_same_thread=False)
c = conn.cursor()

# Create necessary tables
c.execute('''CREATE TABLE IF NOT EXISTS creator_wallets (
                creator_email TEXT PRIMARY KEY,
                balance REAL
            )''')

c.execute('''CREATE TABLE IF NOT EXISTS platform_earnings (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                campaign_id TEXT,
                creator_email TEXT,
                amount_earned REAL
            )''')
conn.commit()

# ----------------- SIDEBAR NAVIGATION -----------------
st.sidebar.markdown("### 💎 UGC GLOBAL PORTAL")
user_role = st.sidebar.selectbox("Select Role", ["Creator Dashboard", "Brand Portal", "Admin"])

# ----------------- 1. CREATOR DASHBOARD -----------------
if user_role == "Creator Dashboard":
    st.header("✨ Creator Earnings & Wallet")
    c_email = st.text_input("Enter Your Email")
    
    if c_email:
        wallet_df = pd.read_sql(f"SELECT balance FROM creator_wallets WHERE creator_email='{c_email}'", conn)
        if not wallet_df.empty:
            bal = wallet_df.iloc[0]['balance']
            st.metric("Available Balance", f"${bal:.2f}")
        else:
            st.metric("Available Balance", "$0.00")
            
        st.markdown("### Submit Completed UGC Content")
        camp_id = st.text_input("Campaign ID")
        p_share = st.number_input("Payout Amount ($)", min_value=0.0, value=100.0)
        
        if st.button("Submit for Verification"):
            if camp_id:
                # Simulating split (50% creator, 50% platform cut)
                creator_share = p_share * 0.5
                platform_share = p_share * 0.5
                
                existing_wallet = pd.read_sql(f"SELECT balance FROM creator_wallets WHERE creator_email='{c_email}'", conn)
                if existing_wallet.empty:
                    c.execute("INSERT INTO creator_wallets (creator_email, balance) VALUES (?, ?)", (c_email, creator_share))
                else:
                    new_bal = existing_wallet.iloc[0]['balance'] + creator_share
                    c.execute("UPDATE creator_wallets SET balance=? WHERE creator_email=?", (new_bal, c_email))
                
                c.execute("INSERT INTO platform_earnings (campaign_id, creator_email, amount_earned) VALUES (?, ?, ?)", 
                          (camp_id, c_email, platform_share))
                
                conn.commit()
                st.success(f"Verified! Credited ${creator_share:.2f} to creator wallet. Platform retained ${platform_share:.2f} (50%).")
            else:
                st.warning("Please enter a Campaign ID.")

# ----------------- 2. BRAND PORTAL -----------------
elif user_role == "Brand Portal":
    st.header("🏢 Brand Campaign Management")
    st.info("Launch campaigns, review creator video pitches, and manage UGC deliverables.")
    
    with st.form("brand_form"):
        brand_name = st.text_input("Brand Name")
        campaign_title = st.text_input("Campaign Title")
        budget = st.number_input("Total Budget ($)", value=1000.0)
        submitted = st.form_submit_button("Launch Campaign")
        
        if submitted:
            st.success(f"Campaign '{campaign_title}' successfully launched for {brand_name}!")

# ----------------- 3. ADMIN PORTAL -----------------
elif user_role == "Admin":
    st.header("⚡ Enterprise Admin Ledger")
    
    df_earnings = pd.read_sql("SELECT * FROM platform_earnings", conn)
    
    if not df_earnings.empty:
        total_profit = df_earnings['amount_earned'].sum()
        st.metric(label="Total Platform Revenue (50% Cuts)", value=f"${total_profit:.2f}")
        st.markdown("### Transaction Ledger")
        st.dataframe(df_earnings, use_container_width=True)
    else:
        st.info("No revenue metrics available yet.")